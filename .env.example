# JWT_SECRET: الزامی است — سرور بدون این مقدار اجرا نمی‌شود.
# یک رشته تصادفی و طولانی (حداقل ۳۲ کاراکتر) قرار دهید. هرگز این مقدار را در گیت‌هاب پابلیک نکنید.
# برای تولید یک مقدار امن این دستور را اجرا کنید:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# NODE_ENV: محیط اجرا — development یا production
NODE_ENV=development

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BASE_URL=https://your-domain.com

# ─── PostgreSQL (برای مهاجرت از SQLite — رجوع کنید به db/schema.sql و
# scripts/migrate-sqlite-to-postgres.ts) ──────────────────────────────────────
# مثال محلی:   postgres://postgres:postgres@localhost:5432/digitalcard
# مثال production: postgres://user:pass@127.0.0.1:5432/digitalcard
DATABASE_URL=postgres://user:password@localhost:5432/digitalcard

# ─── اطلاعات حساب ادمین (Seed) ────────────────────────────────────────────────
# این مقادیر فقط یک‌بار، در اولین اجرای سرور (وقتی هنوز کاربر admin در دیتابیس
# وجود ندارد) برای ساخت حساب ادمین استفاده می‌شوند. مقادیر زیر صرفاً نمونه‌اند؛
# مقدار واقعی را در فایل .env (که کامیت نمی‌شود) قرار دهید.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=مدیر کل پلتفرم
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=change-this-password