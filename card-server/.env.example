# ─── card-server (card.youkart.ir) ───────────────────────────────────────────
# پورت داخلی این سرویس — همین را برای پیکربندی Nginx به کار ببرید
PORT=4000

# باید دقیقاً همان DATABASE_URL پروژه اصلی digital-card باشد (همان دیتابیس Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/digitalcard

# آدرس عمومی همین سرویس (برای og:url و sitemap.xml)
SITE_BASE_URL=https://card.youkart.ir

# آدرس سرور اصلی که فایل‌های /uploads (لوگو، عکس کاور و ...) از آنجا سرو می‌شوند
UPLOADS_BASE_URL=https://youkart.ir

# باید دقیقاً همان مقداری باشد که در .env پروژه اصلی برای INTERNAL_SECRET گذاشته‌اید
# (برای اینکه سرور اصلی بتواند بعد از ذخیره‌ی کارت، کش این سرویس را invalidate کند)
INTERNAL_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
