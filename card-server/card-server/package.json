{
  "name": "card-server",
  "version": "1.0.0",
  "private": true,
  "description": "سرویس مستقل و سبک برای نمایش عمومی و SSR کارت‌های ویزیت روی card.youkart.ir — بدون هیچ وابستگی به داشبورد/ادمین/ادیتور.",
  "type": "module",
  "scripts": {
    "build:client": "vite build --config vite.config.ts",
    "build:ssr": "vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run build:client && npm run build:ssr",
    "dev": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
