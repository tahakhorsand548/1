{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "migrate:pg-schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "migrate:sqlite-to-pg": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@youkart/card-components": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "*",
    "pg": "^8.22.0",
    "qrcode": "*",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "sharp": "^0.35.3",
    "vite": "^6.2.3",
    "ws": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "better-sqlite3": "*",
    "@types/better-sqlite3": "*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "*",
    "@types/node": "^22.14.0",
    "@types/qrcode": "*",
    "@types/ws": "*",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
